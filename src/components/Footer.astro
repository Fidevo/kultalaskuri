---
const currentYear = new Date().getFullYear();
const contactEmail = "info@kultalaskuri.fi";

// Kolme ryhmää (30.9.2026): Kulta / Hopea / Ohjeet ja tietoa. Laskurit oman metallinsa
// ryhmän kärjessä (Kultalaskuri → Kulta, hopealaskuri → Hopea). Umamin mukaan footeria klikataan
// vähän (1.–30.9.2026: 25 nav-clickiä vs. header 285), mutta linkit pysyvät kaikkien sivujen
// löydettävyyden vuoksi. Tiivistys tehtiin toistosta (kolme luottamusriviä → yksi), ei
// pienentämällä tekstiä tai osuma-alueita. Ankkurit samassa linjassa kuin sisältölinkit:
// "hintakehitys" → hintahistoriasivut, "hinta tänään" → hintasivut.
const groups = [
  {
    title: 'Kulta',
    links: [
      { href: '/#laskuri', label: 'Kultalaskuri' },
      { href: '/kullan-hinta/', label: 'Kullan hinta tänään' },
      { href: '/kullan-hintahistoria/', label: 'Kullan hintakehitys' },
      { href: '/kullan-myynti/', label: 'Kullan myynti' },
      { href: '/kullan-myyntipaikat/', label: 'Missä myydä kultaa' },
      { href: '/kullan-leimat/', label: 'Kullan leimat' },
      { href: '/kulta-esineet/', label: 'Kulta eri esineissä' },
      { href: '/kullan-myynti-verotus/', label: 'Kullan myynnin verotus' },
    ],
  },
  {
    title: 'Hopea',
    links: [
      { href: '/hopean-hinta/', label: 'Hopean hinta ja laskuri' },
      { href: '/hopean-hintahistoria/', label: 'Hopean hintakehitys' },
    ],
  },
  {
    title: 'Ohjeet ja tietoa',
    links: [
      { href: '/oppaat/', label: 'Oppaat' },
      { href: '/sanasto/', label: 'Sanasto' },
      { href: '/tietoa/', label: 'Tietoa palvelusta' },
      { href: '/tietosuoja/', label: 'Tietosuojaseloste' },
      { href: '/kayttoehdot/', label: 'Käyttöehdot' },
    ],
  },
];

const linkClass = 'inline-block py-1 text-sm text-gray-300 hover:text-white hover:underline decoration-gold-400/60 underline-offset-4 transition-colors';
const headingClass = 'text-[11px] font-semibold uppercase tracking-[0.18em] text-gold-400 mb-3';
---

<footer class="relative bg-ink-950 border-t border-gold-400/20 mt-auto pt-12 md:pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="grid grid-cols-2 md:grid-cols-12 gap-x-6 gap-y-10 md:gap-12 mb-10 md:mb-12">

      {/* 1. LOGO, KUVAUS, YHTEYS */}
      <div class="col-span-2 md:col-span-4">
        <a href="/" class="inline-flex items-center gap-3 mb-4 group">
          <svg class="w-9 h-9 shrink-0" viewBox="0 0 36 36" fill="none" aria-hidden="true">
            <rect x="0.5" y="0.5" width="35" height="35" rx="3" fill="#0B0F19" stroke="#D4AF37" stroke-opacity="0.45" />
            <svg x="6.5" y="11" width="23" height="14" viewBox="24 110 1018 593">
              <path fill="#D4AF37" d="M24 110h121v263l241-263h161L324 341l235 362H404L241 425l-96 98v180H24z" />
              <path fill="#FFFFFF" d="M624 115h120v488h298v100H624z" />
            </svg>
          </svg>
          <span class="font-serif text-2xl font-semibold tracking-[-0.01em] leading-none">
            <span class="text-gold-400">Kulta</span><span class="text-white">laskuri</span><span class="text-gold-400">.fi</span>
          </span>
        </a>

        {/* Ei "todellinen hinta": laskuri näyttää markkinahinnan ja arvion — käyttöehtojen
            mukaan todellinen myyntihinta voi poiketa siitä. */}
        <p class="text-gray-400 leading-relaxed max-w-sm mb-4 text-sm">
          Laske kulta- ja hopeaesineiden arvo päivän kurssilla ja katso, mitä myynnissä
          kannattaa vähintään tavoitella.
        </p>

        <p class="flex items-start gap-2.5 text-sm text-gray-300 mb-5 max-w-sm">
          <svg class="w-4 h-4 mt-0.5 text-gold-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          <span>Riippumaton suomalainen palvelu — emme osta kultaa tai hopeaa.</span>
        </p>

        <a href={`mailto:${contactEmail}`} class="inline-flex items-center gap-2.5 px-4 py-2.5 rounded-md border border-white/10 bg-white/[0.03] text-sm font-medium text-gray-200 hover:border-gold-400/50 hover:text-white transition-colors">
          <svg class="w-4 h-4 shrink-0 text-gold-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          <span>Yhteistyö & palaute: {contactEmail}</span>
        </a>
      </div>

      {/* 2. KULTA */}
      <nav aria-label="Kulta" class="col-span-1 md:col-span-3">
        <h3 class={headingClass}>{groups[0].title}</h3>
        <ul class="space-y-0.5">
          {groups[0].links.map((link) => <li><a href={link.href} class={linkClass}>{link.label}</a></li>)}
        </ul>
      </nav>

      {/* 3. HOPEA + OHJEET JA TIETOA — mobiilissa samaan sarakkeeseen Kullan viereen */}
      <div class="col-span-1 md:col-span-5 grid md:grid-cols-2 gap-y-8 md:gap-12">
        {groups.slice(1).map((group) => (
          <nav aria-label={group.title}>
            <h3 class={headingClass}>{group.title}</h3>
            <ul class="space-y-0.5">
              {group.links.map((link) => <li><a href={link.href} class={linkClass}>{link.label}</a></li>)}
            </ul>
          </nav>
        ))}
      </div>
    </div>

    {/* ALAREUNA */}
    <div class="pt-6 md:pt-8 border-t border-white/10 text-center md:text-left">
      <p class="text-sm text-gray-400">
        © {currentYear} Kultalaskuri.fi. Kaikki oikeudet pidätetään.
      </p>
    </div>
  </div>
</footer>
