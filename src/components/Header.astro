---
const pathname = Astro.url.pathname;
const normalizedPath = pathname.endsWith('/') && pathname.length > 1 ? pathname.slice(0, -1) : pathname;

const navLinks = [
  { href: '/#laskuri', label: 'Laskuri', pagePath: '/' },
  { href: '/kullan-hinta/', label: 'Kullan hinta', pagePath: '/kullan-hinta' },
  { href: '/kullan-myynti/', label: 'Kullan myynti', pagePath: '/kullan-myynti' },
  { href: '/kullan-leimat/', label: 'Kultaleimat', pagePath: '/kullan-leimat' },
  { href: '/oppaat/', label: 'Oppaat', pagePath: '/oppaat' },
];

// Toissijaiset sivut — näkyvät vain mobiilivalikossa (desktop-navi pidetään tiiviinä)
const secondaryLinks = [
  { href: '/kullan-myyntipaikat/', label: 'Missä myydä kultaa', pagePath: '/kullan-myyntipaikat' },
  { href: '/kulta-esineet/', label: 'Kulta eri esineissä', pagePath: '/kulta-esineet' },
  { href: '/kullan-myynti-verotus/', label: 'Myynnin verotus', pagePath: '/kullan-myynti-verotus' },
  { href: '/sanasto/', label: 'Kultasanasto', pagePath: '/sanasto' },
  { href: '/tietoa/', label: 'Tietoa palvelusta', pagePath: '/tietoa' },
];
---

<header id="main-header" class="fixed top-0 w-full z-50 bg-[#0B0F19]/95 backdrop-blur-md border-b border-white/5 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <a href="/" class="flex flex-col group relative z-50" aria-label="Palaa alkuun">
        <span class="text-2xl font-black tracking-tight leading-none transition-colors">
          <span class="text-gold-400">Kulta</span><span class="text-white">laskuri</span><span class="text-gold-400">.fi</span>
        </span>
        <span class="text-[10px] text-gray-400 uppercase tracking-[0.2em] leading-none mt-1 ml-0.5 group-hover:text-gold-200 transition-colors">
          Luotettava arvio
        </span>
      </a>

      <nav class="hidden md:flex items-center gap-8">
        {navLinks.map((link) => {
          // Tarkistetaan onko linkki sama kuin nykyinen sivu
          const isActive = normalizedPath === link.pagePath;
          
          return (
            <a 
              href={link.href}
              aria-current={isActive ? "page" : undefined}
              class={`text-sm font-bold transition-all duration-200 relative py-2 uppercase tracking-wide
                ${isActive ? 'text-gold-400' : 'text-gray-400 hover:text-gold-400'}
              `}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <div class="flex items-center gap-4 md:hidden">
        <button
          id="mobile-menu-btn"
          type="button"
          class="relative z-50 inline-flex items-center gap-2 min-h-11 px-3 text-sm font-bold text-white rounded-lg border border-white/20 hover:border-gold-400/50 hover:text-gold-200 transition-colors"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          Valikko
          <svg class="w-5 h-5 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  {/* Natiivi <dialog>: selain hoitaa fokuksen siirron, taustan inertiksi teon
      ja Escape-sulkemisen automaattisesti showModal()-kutsun myötä. Tab-kierto
      varmistetaan alla erikseen, koska tuki tälle vaihtelee vielä selaimittain. */}
  <dialog id="mobile-menu" aria-labelledby="mobile-menu-title" class="mobile-navigation md:hidden">
    <div class="flex items-center justify-between gap-3 pb-5 border-b border-white/10">
      <span id="mobile-menu-title" class="text-lg font-black tracking-tight">
        <span class="text-gold-400">Kulta</span><span class="text-white">laskuri</span><span class="text-gold-400">.fi</span>
      </span>
      <button
        id="mobile-menu-close"
        type="button"
        aria-label="Sulje valikko"
        class="text-gray-200 inline-flex items-center justify-center w-11 h-11 border border-white/20 rounded-xl"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6" /></svg>
      </button>
    </div>

    <nav aria-label="Mobiilin päävalikko" class="py-4">
      {navLinks.map((link) => {
        const isActive = normalizedPath === link.pagePath;
        return (
          <a
            href={link.href}
            aria-current={isActive ? "page" : undefined}
            class={`block py-3 text-xl font-bold border-b border-white/5
              ${isActive ? 'text-gold-400' : 'text-white hover:text-gold-400'}
            `}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    {/* Toissijaiset sivut mobiilivalikossa */}
    <nav aria-label="Lisää" class="pb-6">
      <p class="text-[10px] uppercase tracking-[0.2em] text-gray-400 font-bold mb-2">Lisää</p>
      {secondaryLinks.map((link) => {
        const isActive = normalizedPath === link.pagePath;
        return (
          <a
            href={link.href}
            aria-current={isActive ? "page" : undefined}
            class={`block py-3 text-base font-medium
              ${isActive ? 'text-gold-400' : 'text-gray-300 hover:text-gold-400'}
            `}
          >
            {link.label}
          </a>
        );
      })}
    </nav>
  </dialog>
</header>

<script>
  const trigger = document.querySelector<HTMLButtonElement>('#mobile-menu-btn');
  const menu = document.querySelector<HTMLDialogElement>('#mobile-menu');
  const closeBtn = document.querySelector<HTMLButtonElement>('#mobile-menu-close');
  let priorOverflow = '';
  let isOpen = false;

  function openMenu() {
    if (!menu || isOpen) return;
    isOpen = true;
    priorOverflow = document.body.style.overflow;
    menu.showModal();
    document.body.style.overflow = 'hidden'; // Estä taustan skrollaus
    trigger?.setAttribute('aria-expanded', 'true');
    closeBtn?.focus();
  }

  // Ei nojata yksin dialogin natiiviin Escape-/close-käsittelyyn: tila
  // nollataan aina eksplisiittisesti, jotta aria-expanded ja skrollilukko
  // eivät voi jäädä jumiin selaimesta riippumatta.
  function closeMenu() {
    if (!menu || !isOpen) return;
    isOpen = false;
    if (menu.open) menu.close();
    document.body.style.overflow = priorOverflow;
    trigger?.setAttribute('aria-expanded', 'false');
    trigger?.focus({ preventScroll: true });
  }

  trigger?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);

  // Varmuudeksi myös natiivit sulkemistavat (Escape, selaimen oma cancel/close)
  menu?.addEventListener('cancel', closeMenu);
  menu?.addEventListener('close', closeMenu);

  // Oma Escape-kuuntelija varmistaa sulkemisen myös jos dialogin natiivi
  // Escape-käsittely ei laukea kaikissa selaimissa/ympäristöissä.
  menu?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      e.preventDefault();
      closeMenu();
      return;
    }
    // Tab-kierto pysyy valikon sisällä (varmistus fokuslukituksen lisäksi)
    if (e.key !== 'Tab') return;
    const items = Array.from(menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));
    const first = items[0];
    const last = items[items.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last?.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first?.focus();
    }
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  // Jos näyttö kasvaa työpöytäkokoon kesken auki olevan valikon, suljetaan se
  window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
    if (e.matches && isOpen) closeMenu();
  });
</script>