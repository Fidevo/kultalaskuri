---
import { formatEur } from '../lib/utils/formatters';

interface Props {
  karat: string;
  purity: number;
  label: string;
  price: number;
  isHighlighted?: boolean;
}

const { karat, purity, label, price, isHighlighted = false } = Astro.props;

const weights = [1, 5, 10, 50];
---

{/* Kurssilistatyylinen kortti: hiusviivat, tabulaariset luvut oikealle tasattuna.
    Korostettu kortti saa kultaisen yläreunan (ei värikästä taustaa). */}
<div class={`
  bg-white rounded-2xl border transition-colors duration-200
  relative overflow-hidden
  ${isHighlighted
    ? 'border-gold-400/70 shadow-md'
    : 'border-gray-200 shadow-sm hover:border-gray-300'
  }
`}>
  {isHighlighted && <span class="absolute inset-x-0 top-0 h-[3px] bg-gold-400" aria-hidden="true"></span>}

  <div class="flex items-start justify-between gap-4 px-6 pt-6 pb-5 border-b border-gray-200">
    <div>
      <h3 class="text-3xl font-black text-gray-900 tracking-tight leading-none">{karat}</h3>
      <span class="block mt-2 text-[11px] font-semibold text-gold-700 uppercase tracking-[0.14em]">
        {label}
      </span>
    </div>
    <div class="px-2.5 py-1.5 rounded-md bg-gray-50 border border-gray-200
      text-gray-700 font-semibold text-sm num leading-none">
      {purity}
    </div>
  </div>

  <div class="px-6 py-2">
    {weights.map((w, i) => (
      <div class={`flex justify-between items-baseline py-3 ${
        i < weights.length - 1 ? 'border-b border-dashed border-gray-200' : ''
      }`}>
        <span class="text-gray-500 text-sm font-medium">
          {w} gramma{w > 1 ? 'a' : ''}
        </span>
        <span
          class="num text-gray-900 text-lg font-semibold price-value"
          data-price={price * w}
        >
          {formatEur(price * w)} €
        </span>
      </div>
    ))}
  </div>
</div>
