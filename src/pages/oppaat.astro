---
import BaseLayout from '../layouts/BaseLayout.astro';

const dateModified = new Date().toISOString();

// Oppaat neljässä ryhmässä: kullan tunnistus ja arvo, hopea (30.9.2026), myyntipäätös, verotus
// ja termit. Alkuperäinen järjestys myyntiprosessin mukaan: ensin ymmärrys siitä mitä
// itsellä on, sitten myyntipäätös, lopuksi verotus ja termit.
const groups = [
  {
    id: 'tunnista',
    title: 'Ennen myyntiä: tunnista ja arvioi',
    intro: 'Selvitä mitä esineessäsi oikeasti on ja mikä sen arvo on päivän kurssilla.',
    guides: [
      { href: '/kullan-leimat/', name: 'Kullan leimat', desc: 'Mitä 585, 750 ja ulkomaiset karaattimerkinnät tarkoittavat, ja miten erotat aidon kullan kullatusta.' },
      { href: '/kulta-esineet/', name: 'Paljonko kultaa eri esineissä on', desc: 'Kultaosuus esinetyypeittäin — sormukset, ketjut, kultakellot, hammaskulta, kolikot ja harkot.' },
      { href: '/kullan-hinta/', name: 'Kullan hinta tänään', desc: 'Päivän kurssi euroina grammalta, 14K- ja 18K-kullan grammahinnat, unssi- ja kilohinta sekä mistä kullan hinta muodostuu.' },
      { href: '/kullan-hintahistoria/', name: 'Kullan hintakehitys ja hintahistoria', desc: 'Hinta euroina vuodesta 2011: vuositilastot, kuukausimuutokset ja käännekohdat, jotka selittävät suurimmat heilahdukset.' },
    ],
  },
  {
    // Hopeasivut omana ryhmänään (30.9.2026). Kullan myynti-, myyntipaikka- ja verotusoppaita
    // EI nimetä yleisiksi — ne käsittelevät kultaa.
    id: 'hopea',
    title: 'Hopea: hinta ja arvo',
    intro: 'Hopean päivän hinta, hopeaesineen arvo pitoisuuden mukaan ja hopean hintahistoria.',
    guides: [
      { href: '/hopean-hinta/', name: 'Hopean hinta ja hopealaskuri', desc: 'Päivän kurssi euroina grammalta ja kilolta, pitoisuudet 999–350, hopealaskuri, hopean leimat ja alpakan tunnistaminen.' },
      { href: '/hopean-hintahistoria/', name: 'Hopean hintakehitys ja hintahistoria', desc: 'Hinta euroina vuodesta 2011: vuositilastot, kuukausimuutokset ja käännekohdat lähteineen.' },
    ],
  },
  {
    id: 'myynti',
    title: 'Myyntipäätös',
    intro: 'Kun tiedät arvon, valitse miten ja missä myyt — ja miten vertaat saamiasi tarjouksia.',
    guides: [
      { href: '/kullan-myynti/', name: 'Kullan myynti', desc: 'Paljonko kullasta saa, näin myyntitilanne etenee, tarjousten vertailu ja yleisimmät virheet.' },
      { href: '/kullan-myyntipaikat/', name: 'Missä kultaa kannattaa myydä', desc: 'Paikallinen kullanostaja, posti-/verkkopalvelu, panttilainaamo, huutokauppa ja yksityismyynti vertailussa.' },
    ],
  },
  {
    id: 'verotus-termit',
    title: 'Verotus ja termit',
    intro: 'Milloin myynnistä maksetaan veroa, ja mitä alan käsitteet tarkoittavat.',
    guides: [
      { href: '/kullan-myynti-verotus/', name: 'Kullan myynti ja verotus', desc: 'Koti-irtaimiston verovapaus, luovutusvoiton laskenta, perintökulta ja sijoituskulta.' },
      { href: '/sanasto/', name: 'Kultasanasto', desc: 'Karaatti, spot-hinta, hankintameno-olettama, XRF-mittaus ja muut termit selkokielellä.' },
    ],
  },
];

const allGuides = groups.flatMap(g => g.guides);

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://kultalaskuri.fi/#website",
      "url": "https://kultalaskuri.fi",
      "name": "Kultalaskuri.fi",
      "inLanguage": "fi-FI"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Kultalaskuri.fi", "item": "https://kultalaskuri.fi" },
        { "@type": "ListItem", "position": 2, "name": "Oppaat", "item": "https://kultalaskuri.fi/oppaat/" }
      ]
    },
    {
      "@type": "CollectionPage",
      "@id": "https://kultalaskuri.fi/oppaat/",
      "url": "https://kultalaskuri.fi/oppaat/",
      "name": "Kullan ja hopean oppaat",
      "description": "Kootut oppaat kullan ja hopean arvoon ja kullan myyntiin: leimat, esinetyypit, hinnat, hintahistoria, myyntikanavat, verotus ja termit.",
      "inLanguage": "fi-FI",
      "dateModified": dateModified,
      "isPartOf": { "@id": "https://kultalaskuri.fi/#website" },
      "mainEntity": {
        "@type": "ItemList",
        "itemListElement": allGuides.map((g, i) => ({
          "@type": "ListItem",
          "position": i + 1,
          "url": `https://kultalaskuri.fi${g.href}`,
          "name": g.name
        }))
      }
    }
  ]
};
---

<BaseLayout
  title="Kullan ja hopean oppaat | Kultalaskuri.fi"
  description="Kootut oppaat kullan ja hopean arvoon ja kullan myyntiin: leimat, esinetyypit, hinnat, hintahistoria, myyntikanavat, verotus ja termit."
  schema={JSON.stringify(schemaData)}
>

  <div class="relative hero-surface pt-28 pb-20 px-4 overflow-hidden">

    <div class="max-w-3xl mx-auto relative z-10 text-center">
      <nav aria-label="Murupolku" class="mb-6">
        <ol class="flex items-center justify-center gap-2 text-xs text-gray-400">
          <li><a href="/" class="hover:text-gold-400 transition-colors">Etusivu</a></li>
          <li aria-hidden="true">›</li>
          <li aria-current="page" class="text-gray-300">Oppaat</li>
        </ol>
      </nav>

      <div class="kicker-dark">
        Tietopankki
      </div>

      <h1 class="text-3xl md:text-5xl font-black text-white mb-4 leading-tight tracking-tight">
        Kullan ja hopean
        <span class="block text-gold-400 mt-1 pb-1.5">
          oppaat
        </span>
      </h1>
      <p class="text-sm md:text-base text-gray-400 max-w-2xl mx-auto leading-relaxed">
        Riippumatonta tietoa kulta- ja hopeaesineiden arvosta sekä kullan myynnistä — leimoista ja
        hinnoista myyntikanaviin ja verotukseen. Oppaat perustuvat varmistettuun tietoon, eivät
        yksittäisen ostajan lupauksiin.
      </p>
    </div>
  </div>

  <section class="bg-white py-16 px-4">
    <div class="max-w-3xl mx-auto">

      <div class="bg-gray-50 rounded-2xl p-6 border border-gray-200 mb-14 shadow-sm">
        <h2 class="text-lg font-bold text-gray-900 mb-2">Mistä aloittaa</h2>
        <p class="text-gray-600 text-sm leading-relaxed">
          Jos olet myymässä kultaa, luontevin järjestys on: tarkista leima ja mitä esineessä on kultaa,
          <a href="/#laskuri" class="text-gold-600 font-bold hover:underline">laske arvo kultalaskurilla</a>,
          valitse myyntikanava ja vertaa tarjouksia tavoitehintaan. Suuremmissa erissä tarkista lopuksi
          verotus. Hopeaesineen arvon näet
          <a href="/hopean-hinta/#laskuri" class="text-gold-600 font-bold hover:underline">hopealaskurista</a>
          — tarkista ensin pitoisuusleima (esim. 925, 830 tai 813).
        </p>
      </div>

      {groups.map(group => (
        <div class="mb-14 last:mb-0">
          <h2 id={group.id} class="text-2xl md:text-3xl font-black text-gray-900 mb-2 tracking-tight scroll-mt-24">{group.title}</h2>
          <p class="text-gray-500 leading-relaxed mb-6">{group.intro}</p>
          <div class="grid grid-cols-1 gap-4">
            {group.guides.map(guide => (
              <a href={guide.href} data-track="opas-kortti" data-track-name={guide.name} class="group flex items-start gap-4 p-5 rounded-2xl border border-gray-200 bg-white hover:border-gold-300 hover:shadow-sm transition-all">
                <span class="w-2 h-2 rounded-full bg-gold-400 mt-2.5 shrink-0"></span>
                <span class="flex-1 min-w-0">
                  <span class="block text-lg font-bold text-gray-900 group-hover:text-gold-700 transition-colors">{guide.name}</span>
                  <span class="block text-sm text-gray-600 leading-relaxed mt-1">{guide.desc}</span>
                </span>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gold-500 shrink-0 mt-1 group-hover:translate-x-1 transition-transform" aria-hidden="true">
                  <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
                </svg>
              </a>
            ))}
          </div>
        </div>
      ))}

      <div class="relative overflow-hidden hero-surface rounded-2xl p-8 md:p-10 text-center ring-1 ring-gold-400/20 mt-16">
        <h2 class="text-2xl md:text-3xl font-black text-white mb-3">Selvitä esineesi arvo</h2>
        <p class="text-gray-400 mb-6 max-w-xl mx-auto">
          Syötä paino ja pitoisuus, niin näet reilun tavoitehinnan päivän kurssilla — se on jokaisen
          oppaan lähtökohta.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a href="/#laskuri" class="inline-flex items-center justify-center gap-2 bg-gold-400 text-ink-950 px-8 py-4 rounded-lg font-semibold border border-gold-300/60 hover:bg-gold-300 transition-colors duration-200 shadow-sm">
            Laske kultasi arvo →
          </a>
          <a href="/hopean-hinta/#laskuri" class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-lg font-semibold text-white border border-white/20 hover:border-gold-400/60 transition-colors duration-200">
            Laske hopeasi arvo →
          </a>
        </div>
      </div>

    </div>
  </section>

</BaseLayout>
