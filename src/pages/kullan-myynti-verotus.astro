---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqItem from '../components/FaqItem.astro';

// Päivitä tämä päivämäärä (ja sivun "tarkistettu viimeksi" -teksti) vain kun sisältö on oikeasti tarkistettu vero.fi:stä.
const dateModified = '2026-10-08';

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://kultalaskuri.fi/#website",
      "url": "https://kultalaskuri.fi",
      "name": "Kultalaskuri.fi",
      "inLanguage": "fi-FI"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Kultalaskuri.fi", "item": "https://kultalaskuri.fi" },
        { "@type": "ListItem", "position": 2, "name": "Kullan myynti", "item": "https://kultalaskuri.fi/kullan-myynti/" },
        { "@type": "ListItem", "position": 3, "name": "Verotus", "item": "https://kultalaskuri.fi/kullan-myynti-verotus/" }
      ]
    },
    {
      "@type": "WebPage",
      "@id": "https://kultalaskuri.fi/kullan-myynti-verotus/",
      "url": "https://kultalaskuri.fi/kullan-myynti-verotus/",
      "name": "Kullan myynti ja verotus – milloin kullan myynnistä maksetaan veroa?",
      "description": "Pitääkö kullan myynnistä maksaa veroa? Selkeä opas: koti-irtaimiston 5 000 euron verovapaus, hankintameno-olettama, perintökulta ja sijoituskulta.",
      "inLanguage": "fi-FI",
      "dateModified": dateModified,
      "isPartOf": { "@id": "https://kultalaskuri.fi/#website" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Pitääkö kullan myynnistä maksaa veroa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Useimmiten ei. Omien, kotona käytettyjen kultakorujen myynti kuuluu tavanomaisen koti-irtaimiston luovutuksiin, joiden voitot ovat verovapaita 5 000 euroon asti vuodessa. Vasta tämän rajan ylittävältä osalta voitto on veronalaista pääomatuloa. Sijoitustarkoituksessa hankittu kulta, kuten kultaharkot, ei kuulu koti-irtaimistoon, joten sen myyntivoitto on veronalaista pääomatuloa."
          }
        },
        {
          "@type": "Question",
          "name": "Miten kullan myyntivoitto lasketaan?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Luovutusvoitto on myyntihinta miinus hankintameno ja myynnistä aiheutuneet kulut. Vaihtoehtoisesti, tai jos alkuperäistä hankintahintaa ei tiedetä, voi käyttää hankintameno-olettamaa: 20 % myyntihinnasta, jos omaisuus on omistettu alle 10 vuotta, ja 40 %, jos vähintään 10 vuotta. Käytetään sitä vaihtoehtoa, joka on suurempi: olettamaa tai todellista hankintamenoa ja kuluja yhteensä. Perintönä saadun omaisuuden omistusaika lasketaan perittävän kuolemasta."
          }
        },
        {
          "@type": "Question",
          "name": "Miten perintönä saadun kullan verotus toimii?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Perintönä tai lahjana saadun kullan hankintamenona käytetään perintö- tai lahjaverotuksessa käytettyä verotusarvoa. Jos myyntihinta on tätä arvoa korkeampi, erotus on luovutusvoittoa. Poikkeus: jos lahjaksi saatu omaisuus myydään ennen kuin vuosi on kulunut lahjoituksesta, hankintamenona käytetään lahjanantajan hankintamenoa. Vaihtoehtoisesti voi käyttää hankintameno-olettamaa."
          }
        },
        {
          "@type": "Question",
          "name": "Onko sijoituskullan myynti verollista?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Kyllä. Sijoitustarkoituksessa hankitut kultaharkot ja muu sijoitusomaisuus eivät ole tavanomaista koti-irtaimistoa, joten niiden myyntivoitto on veronalaista pääomatuloa ensimmäisestä eurosta alkaen (pienten luovutusten 1 000 euron rajaa lukuun ottamatta). Sijoituskullan ostaminen yksityishenkilönä on sen sijaan arvonlisäverotonta, kun kulta täyttää arvonlisäverolain sijoituskullan määritelmän."
          }
        },
        {
          "@type": "Question",
          "name": "Miten kullan myynti ilmoitetaan verottajalle?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Veronalainen luovutusvoitto ilmoitetaan OmaVerossa tai lomakkeella 9 sen vuoden veroilmoituksella, jona kauppa tehtiin. Tavanomaisen koti-irtaimiston verovapaita myyntejä (voitot enintään 5 000 €/vuosi) ei tarvitse ilmoittaa lainkaan."
          }
        }
      ]
    }
  ]
};

const faqItems = (schemaData["@graph"].find((n: any) => n["@type"] === "FAQPage") as any)?.mainEntity ?? [];
---

<BaseLayout
  title="Kullan myynnin verotus – maksatko veroa? | Kultalaskuri.fi"
  description="Pitääkö kullan myynnistä maksaa veroa? Selkeä opas: koti-irtaimiston 5 000 € verovapaus, hankintameno-olettama 20/40 %, perintökulta ja sijoituskulta."
  schema={JSON.stringify(schemaData)}
>

  <div class="relative hero-surface pt-28 pb-20 px-4 overflow-hidden">

    <div class="max-w-3xl mx-auto relative z-10 text-center">
      <nav aria-label="Murupolku" class="mb-6">
        <ol class="flex items-center justify-center gap-2 text-xs text-gray-400">
          <li><a href="/" class="hover:text-gold-400 transition-colors">Etusivu</a></li>
          <li aria-hidden="true">›</li>
          <li><a href="/kullan-myynti/" class="hover:text-gold-400 transition-colors">Kullan myynti</a></li>
          <li aria-hidden="true">›</li>
          <li aria-current="page" class="text-gray-300">Verotus</li>
        </ol>
      </nav>

      <h1 class="text-3xl md:text-5xl font-black text-white mb-4 leading-tight tracking-tight">
        Kullan myynti ja
        <span class="text-gold-400 pb-1.5">verotus</span>
      </h1>
      <p class="text-sm md:text-base text-gray-400 leading-relaxed max-w-2xl mx-auto">
        Hyvä uutinen useimmille: omien korujen myynti on tavallisesti verovapaata.
        Tällä sivulla käydään läpi, milloin veroa maksetaan, miten voitto lasketaan
        ja miten perintö- ja sijoituskulta eroavat tavallisista koruista.
      </p>
    </div>
  </div>

  <section class="bg-white py-16 px-4">
    <div class="max-w-3xl mx-auto">

      <h2 class="text-3xl font-black text-gray-900 mb-6 tracking-tight">Pääsääntö: korujen myyntivoitot ovat verovapaita 5 000 euroon asti</h2>
      <div class="space-y-4 text-lg text-gray-600 leading-relaxed mb-8">
        <p>
          Omat, kotona käytetyt kultakorut — sormukset, ketjut, rannekorut ja vastaavat —
          lasketaan verotuksessa <strong>tavanomaiseksi koti-irtaimistoksi</strong>. Niiden myynnistä
          saadut <strong>voitot ovat verovapaita siltä osin kuin ne ovat yhteensä enintään
          5 000 euroa vuodessa</strong> (tuloverolaki 48 §). Raja on henkilökohtainen: kunkin
          perheenjäsenen omistaman irtaimiston myyntivoitot lasketaan erikseen.
        </p>
        <p>
          Käytännössä tämä tarkoittaa, että oman kotitalouden vanhojen korujen myynti — esimerkiksi
          muutama sormus ja rikkinäinen ketju — ei aiheuta veroseuraamuksia eikä sitä tarvitse
          edes ilmoittaa veroilmoituksella.
        </p>
        <p class="text-base">
          Jos vuoden myyntihintasi jäävät yhteensä alle 5 000 euroon, myynti on varmasti verovapaa,
          vaikka et tietäisi hankintahintaa. Muussa tapauksessa sekä hankinta- että myyntihinta
          pitää pystyä selvittämään luotettavasti, joten säilytä kuitit ja tositteet.
        </p>
        <p class="text-base">
          <strong>Huomaa kuitenkin rajaus:</strong> verovapaus koskee <em>tavanomaista</em>
          koti-irtaimistoa. Erityisen arvokkaat yksittäiset esineet — esimerkiksi arvokkaat
          taide-esineet tai sijoitusmielessä hankittu omaisuus — eivät välttämättä kuulu sen
          piiriin. Jos myyt poikkeuksellisen arvokasta esineistöä, varmista kohtelu Verohallinnolta.
        </p>
      </div>

      <div class="bg-gold-50/50 border border-gold-200 rounded-2xl p-6 mb-12">
        <h3 class="font-black text-gray-900 mb-2">Lisäksi: pienten luovutusten sääntö</h3>
        <p class="text-gray-600 text-sm leading-relaxed">
          Jos verovuonna myymäsi omaisuuden myyntihinnat ovat <strong>yhteensä enintään
          1 000 euroa</strong>, luovutusvoitot ovat verovapaita omaisuuslajista riippumatta —
          myös sijoituskullan osalta. Summaan ei lasketa tavanomaisen koti-irtaimiston myyntejä
          eikä muita erikseen verovapaiksi säädettyjä luovutuksia (tuloverolaki 48 § 6 mom.).
          Jos 1 000 euron raja ylittyy, myyntivoitto lasketaan normaalisti koko myynnistä.
        </p>
      </div>

      <h2 class="text-3xl font-black text-gray-900 mb-6 tracking-tight">Miten mahdollinen voitto lasketaan?</h2>
      <p class="text-lg text-gray-600 leading-relaxed mb-6">
        Jos verovapaan rajan ylität, veronalainen luovutusvoitto lasketaan näin:
      </p>
      <div class="bg-gray-50 rounded-2xl p-6 md:p-8 border border-gray-200 mb-8">
        <p class="font-mono text-sm md:text-base text-gray-800 mb-4 text-center">
          Voitto = myyntihinta − hankintameno − myyntikulut
        </p>
        <p class="text-gray-600 text-sm leading-relaxed">
          Vaihtoehtoisesti, tai jos et tiedä alkuperäistä hankintahintaa (esim. vuosikymmeniä
          vanha koru), voit käyttää <strong>hankintameno-olettamaa</strong>:
        </p>
        <ul class="mt-4 space-y-2 text-gray-600 text-sm">
          <li class="flex items-start gap-3">
            <span class="w-2 h-2 rounded-full bg-gold-400 mt-2 shrink-0"></span>
            <span><strong>20 % myyntihinnasta</strong>, jos olet omistanut esineen alle 10 vuotta</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-2 h-2 rounded-full bg-gold-400 mt-2 shrink-0"></span>
            <span><strong>40 % myyntihinnasta</strong>, jos olet omistanut esineen vähintään 10 vuotta</span>
          </li>
        </ul>
        <p class="mt-4 text-gray-600 text-sm leading-relaxed">
          Käytössä on se vaihtoehto, joka on suurempi: hankintameno-olettama tai todellinen
          hankintameno ja myyntikulut yhteensä. Olettama korvaa nämä kulut eikä ole lisä niiden
          päälle. Perintönä saadun omaisuuden omistusaika lasketaan perittävän kuolemasta, ja
          lahjana saadun omaisuuden omistusaika lasketaan lahjan saamisesta (ei lahjoittajan omistusajasta).
        </p>
      </div>
      <p class="text-gray-600 leading-relaxed mb-12">
        Veronalainen voitto on pääomatuloa, jonka veroprosentti on 30 % (ja 34 % siltä osin kuin
        pääomatulot ylittävät 30 000 euroa vuodessa).
      </p>

      <h2 class="text-3xl font-black text-gray-900 mb-6 tracking-tight">Perintökulta ja lahjaksi saatu kulta</h2>
      <p class="text-lg text-gray-600 leading-relaxed mb-12">
        Perintönä tai lahjana saadun kullan hankintamenona käytetään
        <strong>perintö- tai lahjaverotuksessa käytettyä verotusarvoa</strong>. Jos myyt korut tätä
        arvoa korkeammalla hinnalla, erotus on luovutusvoittoa. Poikkeus: jos myyt lahjaksi saadun
        omaisuuden ennen kuin vuosi on kulunut lahjoituksesta, hankintamenona käytetään
        <strong>lahjanantajan hankintamenoa</strong> (tuloverolaki 47 §). Koti-irtaimiston 5 000 euron
        verovapauden ehtona on, että myyty esine on tavanomaista koti-irtaimistoa, joka on ollut
        sinun tai perheesi käytössä. Perittyjen korujen kohdalla tilanne kannattaa varmistaa
        Verohallinnolta. Jos kulta myydään ennen perinnönjakoa, myyntivoitto luetaan jakamattoman kuolinpesän
        tuloksi, ja mahdollinen vero määrätään kuolinpesälle eikä perillisille.
        Ennen myyntiä kannattaa myös tarkistaa, onko kyseessä design-koru, jonka arvo ehjänä
        ylittää romukulta-arvon — <a href="/kullan-myynti/" class="text-gold-600 font-bold hover:underline">lue lisää kullan myynnin oppaasta</a>.
      </p>

      <h2 class="text-3xl font-black text-gray-900 mb-6 tracking-tight">Sijoituskulta on eri asia</h2>
      <p class="text-lg text-gray-600 leading-relaxed mb-4">
        Sijoitustarkoituksessa hankitut kultaharkot ja muu sijoitusomaisuus
        <strong>eivät ole tavanomaista koti-irtaimistoa</strong>, joten niiden myyntivoitto on
        veronalaista pääomatuloa ensimmäisestä eurosta alkaen (pienten luovutusten 1 000 euron
        sääntöä lukuun ottamatta). Voiton laskennassa voi käyttää hankintameno-olettamaa samoin
        kuin muussakin omaisuudessa.
      </p>
      <p class="text-gray-600 leading-relaxed mb-12">
        Arvonlisäverotus on oma asiansa: sijoituskullan <em>ostaminen</em> yksityishenkilönä on
        arvonlisäverotonta (AVL 43 a §), kun kulta täyttää sijoituskullan määritelmän. Sen täyttävät
        vähintään 995 tuhannesosan pitoiset kultaharkot ja -levyt, joiden paino on hyväksytty
        kultamarkkinoilla, sekä tietyt ehdot täyttävät kultakolikot (vähintään 900 tuhannesosan
        pitoinen, lyöty vuoden 1800 jälkeen, alkuperämaassa laillinen maksuväline tai se on ollut
        sitä, ja tavanomainen
        myyntihinta enintään 80 prosenttia kullan käypää markkina-arvoa suurempi).
      </p>

      <h2 class="text-3xl font-black text-gray-900 mb-6 tracking-tight">Ilmoittaminen verottajalle</h2>
      <ul class="space-y-3 text-gray-600 mb-6">
        <li class="flex items-start gap-3">
          <span class="w-6 h-6 rounded-full bg-green-100 text-green-700 flex items-center justify-center shrink-0 mt-0.5 text-sm">✓</span>
          <span><strong>Verovapaat koti-irtaimiston myynnit</strong> (voitot enintään 5 000 €/v): ei ilmoitusvelvollisuutta.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-6 h-6 rounded-full bg-gold-100 text-gold-700 flex items-center justify-center shrink-0 mt-0.5 text-sm">!</span>
          <span><strong>Veronalaiset voitot</strong>: ilmoita OmaVerossa esitäytetyn veroilmoituksen kohdassa Luovutusvoitot tai paperilomakkeella 9 (Luovutusvoitto tai -tappio) sen vuoden veroilmoituksella, jona kauppa tehtiin. Säilytä ostokuitit ja myyntitositteet.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-6 h-6 rounded-full bg-gold-100 text-gold-700 flex items-center justify-center shrink-0 mt-0.5 text-sm">!</span>
          <span><strong>Muu kuin koti-irtaimisto</strong>: jos vuoden myyntihinnat ovat yhteensä yli 1 000 euroa ja saat myynnistä voittoa, ilmoita myynnit. Jos tavanomaisen koti-irtaimiston myyntivoitto ylittää 5 000 euroa vuodessa, ilmoita nekin.</span>
        </li>
      </ul>
      <p class="text-gray-600 text-sm leading-relaxed mb-12">
        Satunnainen käytetyn tavaran myynti ei yleensä ole elinkeinotoimintaa. Jos kuitenkin ostat ja
        myyt tavaraa säännöllisesti ja ansaintatarkoituksessa, saadut myyntivoitot ovat
        elinkeinotoiminnan tuloa, joka ilmoitetaan eri tavalla.
      </p>

      <h2 class="text-3xl font-black text-gray-900 mb-8 tracking-tight">Usein kysyttyä kullan myynnin verotuksesta</h2>
      <div id="ukk" class="grid grid-cols-1 gap-4 mb-12">
        {faqItems.map((item: any) => (
          <FaqItem question={item.name} answer={item.acceptedAnswer.text} />
        ))}
      </div>

      <div class="pt-8 border-t border-gray-100 mb-12">
        <p class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-4">Lue myös</p>
        <div data-track-group="lue-myos" class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
          <a href="/kullan-myynti/" class="text-gold-600 font-bold hover:underline">Kullan myynti →</a>
          <a href="/kullan-myyntipaikat/" class="text-gold-600 font-bold hover:underline">Mihin kultakorut kannattaa myydä →</a>
          <a href="/sanasto/#hankintameno-olettama" class="text-gold-600 font-bold hover:underline">Sanasto: hankintameno-olettama →</a>
          <a href="/oppaat/" class="text-gold-600 font-bold hover:underline">Kaikki oppaat →</a>
        </div>
      </div>

      <div class="bg-gray-50 rounded-2xl p-6 border border-gray-200 mb-12">
        <h2 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-3">Lähteet</h2>
        <ul class="space-y-2 text-sm text-gray-600">
          <li>
            <a href="https://www.vero.fi/henkiloasiakkaat/verokortti-ja-veroilmoitus/tulot/ansiotulot/kirpputorimyynti/" rel="noopener" target="_blank" class="text-gold-600 font-bold hover:underline">Vero.fi: Kirpputorimyynti ja koti-irtaimiston myynti</a>
          </li>
          <li>
            <a href="https://www.vero.fi/syventavat-vero-ohjeet/ohje-hakusivu/48935/omaisuuden-luovutusvoitot-ja-tappiot-luonnollisen-henkilon-tuloverotuksessa4/" rel="noopener" target="_blank" class="text-gold-600 font-bold hover:underline">Vero.fi: Omaisuuden luovutusvoitot ja -tappiot tuloverotuksessa</a>
          </li>
          <li>
            <a href="https://www.vero.fi/syventavat-vero-ohjeet/ohje-hakusivu/47810/sijoituskullan-ja-muiden-kultavalmisteiden-arvonlis%C3%A4verotus/" rel="noopener" target="_blank" class="text-gold-600 font-bold hover:underline">Vero.fi: Sijoituskullan ja muiden kultavalmisteiden arvonlisäverotus</a>
          </li>
        </ul>
        <p class="text-xs text-gray-500 mt-4 leading-relaxed">
          Tämä sivu on yleisluontoinen opas, ei veroneuvontaa. Verosäännöt voivat muuttua —
          varmista oma tilanteesi aina vero.fi:stä tai Verohallinnolta.
          Sivu tarkistettu viimeksi 8.10.2026.
        </p>
      </div>

      <div class="relative overflow-hidden hero-surface rounded-2xl p-8 md:p-10 text-center ring-1 ring-gold-400/20">
        <h2 class="text-2xl md:text-3xl font-black text-white mb-3">Selvitä ensin, paljonko kultasi on arvoltaan</h2>
        <p class="text-gray-400 mb-6 max-w-xl mx-auto">Vero lasketaan vasta voitosta — ensin kannattaa tietää reilu myyntihinta.</p>
        <a href="/#laskuri" class="inline-flex items-center justify-center gap-2 bg-gold-400 text-ink-950 px-8 py-4 rounded-lg font-semibold border border-gold-300/60 hover:bg-gold-300 transition-colors duration-200 shadow-sm">
          Laske kultasi arvo →
        </a>
      </div>

    </div>
  </section>

</BaseLayout>
