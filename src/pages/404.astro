---
import BaseLayout from '../layouts/BaseLayout.astro';

// Brändätty 404. Astro tuottaa dist/404.html, jonka GitHub Pages tarjoilee
// automaattisesti kaikille tuntemattomille poluille. noindex (BaseLayout-propi).
const links = [
  {
    href: '/#laskuri',
    title: 'Kultalaskuri',
    desc: 'Laske kultasi arvo painon ja pitoisuuden mukaan päivän kurssilla.',
    icon: '<rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="8" x2="8" y1="14" y2="14"/><line x1="12" x2="12" y1="14" y2="14"/><line x1="16" x2="16" y1="14" y2="14"/><line x1="8" x2="8" y1="18" y2="18"/><line x1="12" x2="12" y1="18" y2="18"/><line x1="16" x2="16" y1="18" y2="18"/>',
  },
  {
    href: '/kullan-hinta/',
    title: 'Kullan hinta',
    desc: 'Päivän kurssi grammalta, karaateittain sekä hintakehitys.',
    icon: '<polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>',
  },
  {
    href: '/kullan-myynti/',
    title: 'Kullan myynti',
    desc: 'Näin saat parhaan hinnan ja vertaat kullanostajien tarjouksia.',
    icon: '<rect width="20" height="12" x="2" y="6" rx="2"/><circle cx="12" cy="12" r="2"/><path d="M6 12h.01M18 12h.01"/>',
  },
  {
    href: '/kullan-myyntipaikat/',
    title: 'Missä kultaa kannattaa myydä',
    desc: 'Kullanostaja, verkkopalvelu, panttilainaamo, huutokauppa ja yksityismyynti.',
    icon: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
  },
  {
    href: '/kullan-leimat/',
    title: 'Kullan leimat',
    desc: 'Mitä 585, 750 ja 375 tarkoittavat — ja miten erotat aidon kullasta.',
    icon: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
  },
  {
    href: '/oppaat/',
    title: 'Kaikki oppaat',
    desc: 'Leimat, esinetyypit, myyntikanavat, verotus ja kultasanasto.',
    icon: '<path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>',
  },
];
---

<BaseLayout
  title="Sivua ei löytynyt (404) | Kultalaskuri.fi"
  description="Etsimääsi sivua ei löytynyt. Siirry kultalaskuriin, kullan hintaan tai myyntioppaisiin."
  noindex={true}
>

  <div class="relative bg-[#0B0F19] pt-28 pb-20 px-4 overflow-hidden">
    <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
      <div class="absolute top-0 right-1/4 w-96 h-96 bg-gold-400/15 rounded-full mix-blend-screen filter blur-[120px] animate-blob"></div>
    </div>

    <div class="max-w-2xl mx-auto relative z-10 text-center">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-gray-400 mb-4">Virhe 404</p>

      <h1 class="text-3xl md:text-5xl font-black text-white mb-4 leading-tight tracking-tight">
        Sivua ei
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-gold-200 to-gold-600 pb-1.5">löytynyt</span>
      </h1>
      <p class="text-sm md:text-base text-gray-400 leading-relaxed max-w-2xl mx-auto">
        Osoite saattaa olla vanhentunut tai kirjoitettu väärin. Alta löydät sivuston
        keskeisimmät sivut — tai palaa
        <a href="/" class="text-gold-400 font-bold hover:text-white transition-colors">etusivulle</a>.
      </p>

      <div class="mt-8">
        <a
          href="/#laskuri"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-gold-400 to-gold-600 text-[#0B0F19] font-bold text-sm hover:scale-[1.03] transition-transform"
        >
          Avaa kultalaskuri
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </div>
  </div>

  <section class="bg-white py-16 px-4">
    <div class="max-w-3xl mx-auto">
      <p class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-6">Suosituimmat sivut</p>

      <div data-track-group="404-linkki" class="grid sm:grid-cols-2 gap-4">
        {links.map((link) => (
          <a
            href={link.href}
            class="group flex gap-4 p-5 rounded-2xl border border-gray-200 bg-white hover:border-gold-300 hover:shadow-sm transition-all"
          >
            <span class="shrink-0 w-11 h-11 rounded-full bg-gold-50 border border-gold-200 text-gold-700 flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" set:html={link.icon} />
            </span>
            <span class="min-w-0">
              <span class="block font-bold text-gray-900 group-hover:text-gold-700 transition-colors">{link.title}</span>
              <span class="block text-sm text-gray-500 leading-relaxed mt-0.5">{link.desc}</span>
            </span>
          </a>
        ))}
      </div>

      <p class="text-sm text-gray-500 leading-relaxed mt-10">
        Löysitkö rikkinäisen linkin? Kerro siitä osoitteeseen
        <a href="mailto:info@kultalaskuri.fi" class="text-gold-600 font-bold hover:underline">info@kultalaskuri.fi</a>.
      </p>
    </div>
  </section>

</BaseLayout>
