---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqItem from '../components/FaqItem.astro';

const dateModified = new Date().toISOString();

// Kanavavertailun tiivistelmä (skannattava taulukko). Aikataulut ja soveltuvuus
// perustuvat kunkin kanavan vakiintuneeseen toimintatapaan, ei yksittäisen
// toimijan lupauksiin.
const channels = [
  { name: 'Paikallinen kullanostaja', speed: 'Maksu heti', fit: 'Nopea raha, pieni erä' },
  { name: 'Posti- tai verkkopalvelu', speed: 'Tyypillisesti 1–3 arkipäivää', fit: 'Kilpailutus, isompi erä' },
  { name: 'Panttilainaamo', speed: 'Raha heti (kyseessä laina)', fit: 'Tilapäinen rahantarve, haluat esineen takaisin' },
  { name: 'Huutokauppa', speed: 'Viikkoja–kuukausia', fit: 'Merkki- tai keräilyarvo selvästi yli sulatusarvon' },
  { name: 'Yksityismyynti', speed: 'Vaihtelee', fit: 'Tunnistettu design- tai keräilyesine sen haluavalle ostajalle' },
];

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://kultalaskuri.fi/#website",
      "url": "https://kultalaskuri.fi",
      "name": "Kultalaskuri.fi",
      "inLanguage": "fi-FI"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Kultalaskuri.fi", "item": "https://kultalaskuri.fi" },
        { "@type": "ListItem", "position": 2, "name": "Mihin kultakorut kannattaa myydä?", "item": "https://kultalaskuri.fi/kullan-myyntipaikat/" }
      ]
    },
    {
      "@type": "WebPage",
      "@id": "https://kultalaskuri.fi/kullan-myyntipaikat/",
      "url": "https://kultalaskuri.fi/kullan-myyntipaikat/",
      "name": "Mihin kultakorut kannattaa myydä?",
      "description": "Pyydä tarjous useammalta ostajalta ja vertaa tavoitehintaan. Kanavat vertailussa: kullanostaja, posti, panttilainaamo, huutokauppa ja yksityismyynti.",
      "inLanguage": "fi-FI",
      "dateModified": dateModified,
      "isPartOf": { "@id": "https://kultalaskuri.fi/#website" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Mihin kultakorut kannattaa myydä?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Umpikultakorut ja romukulta kannattaa yleensä myydä kullanostajalle tai posti- ja verkkopalvelulle, koska niiden arvo on käytännössä metalliarvo. Pyydä tarjous vähintään kahdesta tai kolmesta paikasta: tarjoukset samasta esineestä voivat erota paljon. Ylen vertailussa (toukokuu 2025) neljän helsinkiläisen liikkeen tarjoukset samasta kultahampaasta vaihtelivat 210 eurosta 501 euroon. Vertaa jokaista tarjousta laskurin tavoitehintaan eli tasoon, jota kannattaa vähintään tavoitella. Nimekkäät design-korut, vanhat merkkikellot ja keräilyesineet kannattaa arvioida ensin esineenä, koska huutokauppa tai oikea yksityisostaja voi maksaa niistä metalliarvoa enemmän."
          }
        },
        {
          "@type": "Question",
          "name": "Kannattaako kulta viedä panttilainaamoon?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Panttilainaamon perustoiminta on lainan antaminen panttia vastaan, ei kullan ostaminen. Lainan määrä perustuu panttilainaamon arvioon esineestä ja jää selvästi sen myyntiarvoa pienemmäksi; laki ei aseta kiinteää enimmäisprosenttia. Lainasta peritään korkoa ja kuluja, ja laina-aika on enintään vuosi kerrallaan. Jos et lunasta panttia, esine myydään ja velkasi ylittävä osa tilitetään sinulle — alijäämää laitos ei saa periä sinulta. Panttilainaamo sopii tilanteeseen, jossa tarvitset rahaa tilapäisesti mutta haluat esineen takaisin. Osa panttilainaamoista ostaa koruja myös suoraan, jolloin kyseessä on tavallinen myynti."
          }
        },
        {
          "@type": "Question",
          "name": "Paljonko huutokauppa ottaa provisiota korujen myynnistä?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Myyjän provisio on suomalaisissa huutokauppataloissa tyypillisesti noin 15–25 prosenttia vasarahinnasta, ja lisäksi voi tulla esimerkiksi vakuutusmaksu. Ostaja maksaa vielä erikseen ostoprovision vasarahinnan päälle. Prosessi kestää yleensä viikkoja tai kuukausia, eikä kohde välttämättä mene kaupaksi, jos se ei saavuta myyjän kanssa sovittua pohjahintaa. Huutokauppa kannattaa lähinnä silloin, kun esineen keräily- tai merkkiarvo ylittää selvästi sen sulatusarvon."
          }
        },
        {
          "@type": "Question",
          "name": "Miten varmistan, että kullanostaja on luotettava?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pyydä aina kirjallinen erittely painosta, pitoisuudesta ja päivän kurssista, ja varmista että esineet punnitaan silmiesi edessä. Jos ostaja ottaa vastaan tai maksaa käteistä vähintään 10 000 euroa, sen on rahanpesulain mukaan oltava Lupa- ja valvontaviraston julkisessa rahanpesun valvontarekisterissä. Varaa mukaan henkilöllisyystodistus — ostajat pyytävät sitä yleisesti. Vertaa saatua tarjousta laskurin antamaan tavoitehintaan ennen päätöstä."
          }
        },
        {
          "@type": "Question",
          "name": "Voiko kultaa myydä yksityisesti esimerkiksi torilla tai Facebookissa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Voi, mutta yksityishenkilöiden välisessä kaupassa ei ole kuluttajansuojaa, ja maksupetokset ovat riski: väärennetty kuitti, peruutettu tilisiirto tai tekaistu käteinen. Käytä vain vahvistettua, tilillä näkyvää maksua ennen esineen luovutusta ja tapaa turvallisessa paikassa. Yksityismyynti kannattaa käytännössä vain tunnistetuille design- tai keräilyesineille, joista ostaja maksaa esineenä enemmän kuin kullanostaja sulatusarvona."
          }
        }
      ]
    }
  ]
};

const faqItems = (schemaData["@graph"].find((n: any) => n["@type"] === "FAQPage") as any)?.mainEntity ?? [];
---

<BaseLayout
  title="Mihin kultakorut kannattaa myydä? Kanavat vertailussa | Kultalaskuri.fi"
  description="Pyydä tarjous useammalta ostajalta ja vertaa tavoitehintaan. Kanavat vertailussa: kullanostaja, posti, panttilainaamo, huutokauppa ja yksityismyynti."
  schema={JSON.stringify(schemaData)}
>

  <div class="relative hero-surface pt-28 pb-20 px-4 overflow-hidden">

    <div class="max-w-3xl mx-auto relative z-10 text-center">
      <nav aria-label="Murupolku" class="mb-6">
        <ol class="flex items-center justify-center gap-2 text-xs text-gray-400">
          <li><a href="/" class="hover:text-gold-400 transition-colors">Etusivu</a></li>
          <li aria-hidden="true">›</li>
          <li aria-current="page" class="text-gray-300">Mihin myydä kultakorut</li>
        </ol>
      </nav>

      <div class="kicker-dark">
        Myyntikanavat
      </div>

      <h1 class="text-3xl md:text-5xl font-black text-white mb-4 leading-tight tracking-tight">
        Mihin kultakorut
        <span class="block text-gold-400 mt-1 pb-1.5">
          kannattaa myydä?
        </span>
      </h1>
      <p class="text-sm md:text-base text-gray-400 max-w-2xl mx-auto leading-relaxed">
        Kanavan valinta riippuu siitä, mitä arvostat: nopeutta, korkeinta hintaa vai mahdollisuutta
        saada esine takaisin. Alla viisi tapaa myydä kultaa Suomessa — miten kukin toimii, mitä se
        maksaa ja kenelle se sopii.
      </p>
    </div>
  </div>

  <section class="bg-white py-16 px-4">
    <div class="max-w-3xl mx-auto">

      {/* Lyhyt vastaus hakijan kysymykseen ("mihin kultakorut kannattaa myydä") ennen
          sisällysluetteloa — tiivis muoto, josta myös AI-hakujen yhteenvedot poimivat.
          Lähdeluvut tarkistettu Ylen jutusta 8.10.2026 (sääntö 6); liikkeitä ei nimetä. */}
      <div class="mb-12 p-6 md:p-8 rounded-2xl border border-gold-200 bg-gold-50/40">
        <p class="text-xs font-bold uppercase tracking-widest text-gold-700 mb-3">Lyhyt vastaus</p>
        <p class="text-base md:text-lg text-gray-800 leading-relaxed mb-4">
          Umpikultakorut ja romukulta kannattaa yleensä myydä <strong>kullanostajalle tai posti- ja
          verkkopalvelulle</strong>, koska niiden arvo on käytännössä metalliarvo. Pyydä tarjous vähintään
          kahdesta tai kolmesta paikasta: erot voivat olla suuria.
          <a href="https://yle.fi/a/74-20160762" rel="noopener" target="_blank" class="text-gold-700 font-semibold underline underline-offset-2 decoration-gold-400/50 hover:decoration-gold-600">Ylen vertailussa</a>
          neljän helsinkiläisen liikkeen tarjoukset samasta kultahampaasta vaihtelivat 210 eurosta 501 euroon.
        </p>
        <p class="text-gray-700 leading-relaxed mb-4">
          Nimekkäät design-korut, vanhat merkkikellot ja keräilyesineet kannattaa arvioida ensin esineenä,
          koska huutokauppa tai oikea yksityisostaja voi maksaa niistä metalliarvoa enemmän.
        </p>
        <p class="text-gray-700 leading-relaxed mb-6">
          Ennen tarjousten pyytämistä laske <strong>tavoitehinta</strong> eli taso, jota kannattaa vähintään
          tavoitella, ja vertaa jokaista saamaasi tarjousta siihen laskurin tarjousvertailulla.
        </p>
        <a href="/#laskuri" class="flex sm:inline-flex w-full sm:w-auto items-center justify-center gap-2 text-center bg-ink-950 text-white px-6 py-3 rounded-lg font-semibold hover:bg-ink-800 transition-colors duration-200">
          Laske tavoitehinta ja vertaa tarjouksia →
        </a>
      </div>

      <nav aria-label="Sisällysluettelo" class="mb-12 p-6 bg-gray-50 rounded-2xl border border-gray-200">
        <h2 class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-4">Tällä sivulla</h2>
        <ol class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2 text-sm">
          <li><a href="#vertailu" class="text-gold-600 font-bold hover:underline">Kanavat lyhyesti</a></li>
          <li><a href="#kullanostaja" class="text-gold-600 font-bold hover:underline">Paikallinen kullanostaja</a></li>
          <li><a href="#verkkopalvelu" class="text-gold-600 font-bold hover:underline">Posti- ja verkkopalvelu</a></li>
          <li><a href="#panttilainaamo" class="text-gold-600 font-bold hover:underline">Panttilainaamo</a></li>
          <li><a href="#huutokauppa" class="text-gold-600 font-bold hover:underline">Huutokauppa</a></li>
          <li><a href="#yksityismyynti" class="text-gold-600 font-bold hover:underline">Yksityismyynti</a></li>
          <li><a href="#luotettavuus" class="text-gold-600 font-bold hover:underline">Näin varmistat ostajan</a></li>
          <li><a href="#ukk" class="text-gold-600 font-bold hover:underline">Usein kysyttyä</a></li>
        </ol>
      </nav>

      <h2 id="vertailu" class="text-3xl md:text-4xl font-black text-gray-900 mb-6 tracking-tight scroll-mt-24">Kanavat lyhyesti</h2>
      <p class="text-lg text-gray-600 leading-relaxed mb-6">
        Selvitä ensin, mikä on kultasi reilu tavoitehinta — se on vertailukohta jokaiselle tarjoukselle.
        <a href="/#laskuri" class="text-gold-600 font-bold hover:underline">Laske se laskurilla</a>, ja
        valitse sitten kanava sen mukaan, mitä tilanteesi vaatii.
      </p>

      <div class="bg-gray-50 rounded-2xl p-6 border border-gray-200 mb-8 shadow-sm">
        <h3 class="text-lg font-bold text-gray-900 mb-3">Nopea valinta</h3>
        <ul class="space-y-2 text-gray-700 text-sm leading-relaxed">
          <li><strong>Tarvitset rahat heti:</strong> paikallinen kullanostaja</li>
          <li><strong>Haluat parhaan hinnan romukullasta:</strong> kilpailuta kullanostajia ja verkkopalveluita</li>
          <li><strong>Esineellä on merkki- tai keräilyarvo:</strong> huutokauppa tai tunnistetulle ostajalle yksityismyynti</li>
          <li><strong>Et halua myydä lopullisesti:</strong> panttilainaamo (laina, esine takaisin lunastamalla)</li>
        </ul>
      </div>

      {/* MOBIILI: korttilista — ei sivusuuntaista vieritystä */}
      <div class="md:hidden space-y-3 mb-6">
        {channels.map(ch => (
          <div class="p-4 rounded-2xl border border-gray-200 bg-white shadow-sm">
            <p class="font-bold text-gray-900 mb-2">{ch.name}</p>
            <p class="text-sm text-gray-600"><span class="text-gray-500">Aikataulu:</span> {ch.speed}</p>
            <p class="text-sm text-gray-600 mt-0.5"><span class="text-gray-500">Kenelle:</span> {ch.fit}</p>
          </div>
        ))}
      </div>

      {/* DESKTOP: taulukko */}
      <div class="hidden md:block overflow-x-auto mb-6 rounded-2xl border border-gray-200 shadow-sm">
        <table class="w-full text-left border-collapse">
          <caption class="sr-only">Kullan myyntikanavien aikataulu ja soveltuvuus</caption>
          <thead>
            <tr class="bg-gray-50 border-b border-gray-300 text-[11px] uppercase tracking-[0.12em] text-gray-600">
              <th class="py-4 px-5 font-semibold">Kanava</th>
              <th class="py-4 px-5 font-semibold">Aikataulu</th>
              <th class="py-4 px-5 font-semibold">Kenelle sopii</th>
            </tr>
          </thead>
          <tbody class="text-gray-700 divide-y divide-gray-100 bg-white">
            {channels.map(ch => (
              <tr class="hover:bg-gray-50 transition-colors align-top">
                <td class="py-3.5 px-5 font-bold text-gray-900">{ch.name}</td>
                <td class="py-3.5 px-5">{ch.speed}</td>
                <td class="py-3.5 px-5">{ch.fit}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-sm text-gray-500 leading-relaxed mb-16">
        Nyrkkisääntö: umpikultakorut ja romukulta kannattaa myydä kullanostajalle tai verkkopalvelulle,
        koska niiden arvo on käytännössä metalliarvo. Merkki- ja keräilyesineet — nimekkäät design-korut,
        vanhat kellot ja kolikot — kannattaa arvioida ensin esineenä, koska huutokauppa tai oikea
        yksityisostaja voi maksaa niistä sulatusarvoa enemmän.
      </p>

      <h2 id="kullanostaja" class="text-3xl md:text-4xl font-black text-gray-900 mb-6 tracking-tight scroll-mt-24">Paikallinen kullanostaja</h2>
      <p class="text-lg text-gray-600 leading-relaxed mb-6">
        Jalometalliliike tai kultaan erikoistunut ostaja punnitsee ja testaa esineet paikan päällä,
        antaa tarjouksen ja maksaa yleensä heti. Nopein tapa saada rahat, ja voit asioida kasvotusten.
      </p>
      <ul class="space-y-3 text-gray-600 leading-relaxed mb-6 list-disc pl-5">
        <li><strong>Maksu ja aikataulu:</strong> yleensä tilisiirtona saman käynnin aikana; pienemmät summat voidaan maksaa myös käteisenä.</li>
        <li><strong>Mitä varmista:</strong> että esineet punnitaan silmiesi edessä, ja pyydä kirjallinen erittely painosta, pitoisuudesta ja päivän kurssista. Sinulla on oikeus kieltäytyä tarjouksesta.</li>
        <li><strong>Henkilöllisyystodistus:</strong> ostajat pyytävät sitä yleisesti, joten ota se mukaan. Rahanpesulaki velvoittaa tunnistamaan asiakkaan esimerkiksi silloin, kun kaupassa liikkuu käteistä vähintään 10 000 euroa.</li>
      </ul>
      <p class="text-gray-600 leading-relaxed mb-16">
        Hinnat vaihtelevat ostajittain, joten pyydä tarjous useammasta paikasta ja vertaa niitä
        <a href="/kullan-myynti/#vertaa-tarjouksia" class="text-gold-600 font-bold hover:underline">tavoitehintaan</a>.
      </p>

      <h2 id="verkkopalvelu" class="text-3xl md:text-4xl font-black text-gray-900 mb-6 tracking-tight scroll-mt-24">Posti- ja verkkopalvelu</h2>
      <p class="text-lg text-gray-600 leading-relaxed mb-6">
        Lähetät kullan vakuutettuna postitse, palvelu arvioi sen ja tekee tarjouksen, jonka voit
        hyväksyä tai hylätä. Maksu tulee yleensä tilisiirtona muutamassa arkipäivässä. Helppo tapa
        kilpailuttaa useampi toimija, mutta prosessi kestää kauemmin kuin liikkeessä käynti.
      </p>
      <ul class="space-y-3 text-gray-600 leading-relaxed mb-16 list-disc pl-5">
        <li><strong>Ennen lähetystä varmista:</strong> palauttaako palvelu esineet veloituksetta, jos hylkäät tarjouksen, ja kuka vastaa lähetyksen katoamisesta.</li>
        <li><strong>Dokumentoi:</strong> valokuvaa esineet ja punnitse ne itse ennen lähetystä.</li>
        <li><strong>Tarjouksen sitovuus:</strong> tarkista, onko ennakkoon annettu arvio sitova vai vasta suuntaa-antava.</li>
      </ul>

      <h2 id="panttilainaamo" class="text-3xl md:text-4xl font-black text-gray-900 mb-6 tracking-tight scroll-mt-24">Panttilainaamo</h2>
      <p class="text-lg text-gray-600 leading-relaxed mb-6">
        Panttilainaamon perustoiminta on <strong>lainan antaminen irtainta panttia vastaan</strong>, ei
        kullan ostaminen. Toimintaa säätelee laki panttilainauslaitoksista (1353/1992), ja laitos
        tarvitsee toimiluvan.
      </p>
      <ul class="space-y-3 text-gray-600 leading-relaxed mb-6 list-disc pl-5">
        <li><strong>Lainan määrä</strong> perustuu panttilainaamon tekemään arvioon esineestä ja jää selvästi sen arvioitua myyntiarvoa pienemmäksi. Laki ei aseta kiinteää enimmäisprosenttia.</li>
        <li><strong>Laina-aika</strong> on enintään vuosi kerrallaan, ja lainasta peritään korkoa ja kuluja — usein enemmän kuin pankkilainasta.</li>
        <li><strong>Jos et lunasta panttia</strong> laina-ajan loppuun mennessä, esine myydään. Velkasi ylittävä osuus myyntihinnasta tilitetään sinulle, eikä laitos saa periä sinulta mahdollista alijäämää.</li>
      </ul>
      <p class="text-gray-600 leading-relaxed mb-16">
        Panttilainaamo sopii tilapäiseen rahantarpeeseen, kun haluat pitää mahdollisuuden saada esine
        takaisin. Osa panttilainaamoista ostaa koruja myös suoraan — silloin kyseessä on tavallinen
        myynti, jota kannattaa verrata muihin ostajiin.
      </p>

      <h2 id="huutokauppa" class="text-3xl md:text-4xl font-black text-gray-900 mb-6 tracking-tight scroll-mt-24">Huutokauppa</h2>
      <p class="text-lg text-gray-600 leading-relaxed mb-6">
        Huutokauppatalo ottaa esineen myyntiin, luetteloi sen ja myy eniten tarjoavalle. Tämä on tapa
        tavoittaa keräilijät, jotka maksavat esineestä enemmän kuin sen metalliarvo — mutta vain jos
        esineellä on sellaista arvoa.
      </p>
      <ul class="space-y-3 text-gray-600 leading-relaxed mb-6 list-disc pl-5">
        <li><strong>Myyjän provisio:</strong> tyypillisesti noin 15–25 % vasarahinnasta, ja lisäksi voi tulla esimerkiksi vakuutusmaksu. Ostaja maksaa erikseen ostoprovision.</li>
        <li><strong>Aikataulu:</strong> viikoista kuukausiin luettelointiaikataulun mukaan; maksu tilitetään vasta huutokaupan jälkeen.</li>
        <li><strong>Ei takuuta kaupasta:</strong> jos kohde ei saavuta myyjän kanssa sovittua pohjahintaa, se jää myymättä. Lähtöhinta on yleensä vain arvio — tarkista kyseisen huutokauppatalon ehdot.</li>
      </ul>
      <p class="text-gray-600 leading-relaxed mb-16">
        Kannattaa siis lähinnä silloin, kun nimekkään suunnittelijan koru, vanha merkkikello tai
        harvinainen kolikko on selvästi sulatusarvoaan arvokkaampi. Tavallinen romukulta menettää
        huutokaupassa provisioiden verran.
      </p>

      <h2 id="yksityismyynti" class="text-3xl md:text-4xl font-black text-gray-900 mb-6 tracking-tight scroll-mt-24">Yksityismyynti</h2>
      <p class="text-lg text-gray-600 leading-relaxed mb-6">
        Kun tiedät mitä myyt — nimekäs design-koru, tunnettu merkkikello tai keräilykolikko — suora
        myynti toiselle yksityishenkilölle esimerkiksi Tori.fi:ssä tai keräilijäryhmissä voi tuottaa
        selvästi paremman hinnan kuin kullanostaja, joka maksaa vain sulatusarvon. Ilman välikättä
        vastuu ja riskit ovat kuitenkin sinulla.
      </p>
      <ul class="space-y-3 text-gray-600 leading-relaxed mb-6 list-disc pl-5">
        <li><strong>Ei kuluttajansuojaa:</strong> yksityishenkilöiden välisessä kaupassa kuluttajansuojalaki ei suojaa kumpaakaan osapuolta.</li>
        <li><strong>Maksupetoksen riski:</strong> väärennetty kuitti, myöhemmin peruttu tilisiirto tai tekaistu käteinen. Luovuta esine vasta, kun maksu näkyy omalla tililläsi.</li>
        <li><strong>Tapaaminen:</strong> sovi julkinen paikka; arvokkaammissa kaupoissa pankin tiski on turvallinen.</li>
      </ul>
      <p class="text-gray-600 leading-relaxed mb-16">
        Realistinen vaihtoehto lähinnä tunnistetuille design- ja keräilyesineille.
      </p>

      <h2 id="luotettavuus" class="text-3xl md:text-4xl font-black text-gray-900 mb-6 tracking-tight scroll-mt-24">Näin varmistat ostajan</h2>
      <ul class="space-y-3 text-gray-600 leading-relaxed mb-6 list-disc pl-5">
        <li><strong>Rahanpesun valvontarekisteri:</strong> tavarakauppiaan, joka ottaa vastaan tai maksaa käteistä vähintään 10 000 euroa yhtenä tai toisiinsa kytkeytyvinä suorituksina, on kuuluttava Lupa- ja valvontaviraston julkiseen rekisteriin. Rekisterin löydät <a href="https://lvv.fi/raha-omaisuus-ja-kiinteistonvalitys/rahanpesun-valvontarekisteri" rel="noopener" target="_blank" class="text-gold-600 font-bold hover:underline">Lupa- ja valvontaviraston sivulta</a>.</li>
        <li><strong>Kirjallinen erittely:</strong> paino, pitoisuus, päivän kurssi ja tarjottu summa eriteltyinä.</li>
        <li><strong>Läpinäkyvä punnitus ja testaus</strong> asiakkaan nähden.</li>
        <li><strong>Vertaa tavoitehintaan:</strong> tuo mukaan tuloste tai kuva <a href="/#laskuri" class="text-gold-600 font-bold hover:underline">laskurin</a> antamasta tasosta.</li>
